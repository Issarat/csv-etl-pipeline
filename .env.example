# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://etl_user:etl_password@localhost:5433/olist

# Optional: enable PostgreSQL integration tests after creating olist_test
# TEST_DATABASE_URL=postgresql+psycopg://etl_user:etl_password@localhost:5433/olist_test
# Docker Desktop Linux daemon path for D:\csv-etl-pipeline.
# On Linux/macOS replace with the project absolute path visible to Docker.
ETL_HOST_PROJECT_DIR=/run/desktop/mnt/host/d/csv-etl-pipeline

MINIO_ROOT_USER=local_admin
MINIO_ROOT_PASSWORD=local-dev-password-123

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=local_admin
S3_SECRET_ACCESS_KEY=local-dev-password-123
S3_BUCKET=olist-pipeline
S3_REGION=us-east-1